      "configuration": {
        "variableTable": "u_asset_attributes",
        "relationshipType": "direct",
        "displayFields": "attribute_name,attribute_value,category",
        "showLabels": true,
        "maxRecords": 40
      },
      "useCase": "Asset management pages"
    },
    {
      "name": "Survey Responses",
      "description": "Display survey responses as variables",
      "configuration": {
        "variableTable": "asmt_metric_result",
        "relationshipType": "direct",
        "displayFields": "metric_type.name,string_value,number_value",
        "showLabels": true,
        "maxRecords": 30
      },
      "useCase": "Assessment and survey result pages"
    }
